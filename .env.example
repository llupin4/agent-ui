# ---- Model (server-side only; never exposed to the browser) ----------------
# "provider/model" string understood by CopilotKit's BuiltInAgent
# (openai/..., anthropic/..., google/...). Change freely.
AGENT_MODEL=anthropic/claude-sonnet-4-6

# API key for the provider named in AGENT_MODEL. Only the matching one is needed.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# ---- Fixture mode ----------------------------------------------------------
# 1 = replace the model with a scripted, clearly labeled fixture model so the
# whole A2UI loop can be exercised without credentials. Everything else
# (BuiltInAgent, tools, A2UI middleware, runner, persistence) is the real path.
FIXTURE_MODE=0

# ---- Observability ---------------------------------------------------------
# Runtime debug logging to the server console: off | on | verbose
# (verbose logs full event payloads, including message text).
RUNTIME_DEBUG=on
# 1 = record AI SDK call parameters / stream summaries at the model-provider
# boundary into a bounded in-memory buffer shown in "View details".
PROVIDER_TRACE=1

# ---- Persistence -----------------------------------------------------------
# Directory for the SQLite files (gitignored). Relative to the project root.
DATA_DIR=./data
